{
  "manifest_version": 3,
  "name": "Research Buddy",
  "version": "3.0.0",
  "description": "A simple web research highlighter and notes saver.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}